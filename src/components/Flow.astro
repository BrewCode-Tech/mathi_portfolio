---
import type { Project } from '../content/profile';

interface Props {
  steps: Project['flow'];
  compact?: boolean;
}
const { steps, compact = false } = Astro.props;
---
<ol class:list={['flow', { compact }]}>
  {steps.map((s, i) => (
    <li class={s.tone ?? 'plain'}>
      <span class="n">{String(i + 1).padStart(2, '0')}</span>
      <strong>{s.label}</strong>
      {!compact && <span class="d">{s.detail}</span>}
    </li>
  ))}
</ol>

<style>
  .flow { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; counter-reset: s; }
  @media (min-width: 860px) {
    .flow:not(.compact) { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); grid-auto-flow: column; }
  }
  li {
    position: relative; padding: 14px 16px; border-radius: 12px;
    border: 1px solid var(--line); background: var(--card);
    display: flex; flex-direction: column; gap: 4px;
  }
  li strong { font-weight: 600; font-size: 16px; }
  .n { font: 500 11px/1 var(--mono); color: var(--ink-3); }
  .d { font-size: 14px; line-height: 1.45; color: var(--ink-2); }
  .ai { background: var(--ai-soft); border-color: color-mix(in srgb, var(--ai) 30%, transparent); }
  .ai .n, .ai strong { color: var(--ai); }
  .guard { background: var(--guard-soft); border-color: color-mix(in srgb, var(--guard) 30%, transparent); }
  .guard .n, .guard strong { color: var(--guard); }
  .human { background: var(--human-soft); border-color: color-mix(in srgb, var(--human) 30%, transparent); }
  .human .n, .human strong { color: var(--human); }

  .compact { display: flex; flex-wrap: wrap; gap: 6px; }
  .compact li { flex-direction: row; align-items: center; padding: 5px 10px; border-radius: 999px; gap: 6px; }
  .compact li strong { font-size: 13px; font-weight: 500; }
  .compact .n { display: none; }
</style>
