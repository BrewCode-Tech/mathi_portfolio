---
import Base from '../layouts/Base.astro';
import Flow from '../components/Flow.astro';
import { person, highlights, roles, company, projects, skills, education } from '../content/profile';

const base = import.meta.env.BASE_URL;
const ladder = ['Intern', 'QA Engineer', 'Full Stack', 'Senior', 'Lead'];
---
<Base>
  <main>
    <div class="wrap hero">
      <div class="id">
        <img class="avatar" src={`${base}me.jpg`} alt={`Portrait of ${person.name}`} width="88" height="88" />
        <div>
          <p class="status"><span class="dot"></span>{person.availability}</p>
          <p class="loc">{person.location}</p>
        </div>
      </div>
      <h1>{person.name}</h1>
      <p class="role">{person.headline}</p>
      <p class="pitch">{person.pitch}</p>
      <div class="ctas">
        <a class="btn primary" href={`${base}resume/`}>View resume</a>
        <a class="btn" href={`mailto:${person.email}`}>Email me</a>
        <a class="btn" href={person.links.linkedin} rel="me">LinkedIn</a>
        <a class="btn" href={person.links.github} rel="me">GitHub</a>
      </div>
    </div>

    <div class="wrap">
      <dl class="stats">
        {highlights.map((h) => (
          <div><dt>{h.value}</dt><dd>{h.label}</dd></div>
        ))}
      </dl>
    </div>

    <section id="work">
      <div class="wrap">
        <p class="eyebrow">Selected work</p>
        <h2>LLMs with guardrails, <em>not vibes</em></h2>
        <p class="lede muted">A pattern runs through my work: deterministic code decides when a model is trusted, when a second model is called, and when a human takes over.</p>
        <div class="legend">
          <span><i class="ai"></i>Model call</span>
          <span><i class="guard"></i>Deterministic check</span>
          <span><i class="human"></i>Human in the loop</span>
        </div>
        <div class="cards">
          {projects.map((p) => (
            <a class="card" href={`${base}projects/${p.slug}/`}>
              <div class="card-top">
                <span class="eyebrow">{p.kind}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </div>
              <h3>{p.name}</h3>
              <p class="muted">{p.tagline}</p>
              <Flow steps={p.flow} compact />
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="experience">
      <div class="wrap">
        <p class="eyebrow">Experience</p>
        <h2>One company, five rungs</h2>
        <ol class="ladder" aria-label="Promotion path">
          {ladder.map((r, i) => <li style={`--i:${i}`}>{r}</li>)}
        </ol>
        <p class="co"><strong>{company.name}</strong>, {company.place} · <span class="muted">{company.dates} · all client work for US products</span></p>
        <div class="timeline">
          {roles.map((r) => (
            <article>
              <div class="when">{r.dates}</div>
              <div>
                <h3>{r.title}</h3>
                {r.engagements.map((e) => (
                  <div class="eng">
                    {e.product && <p class="ctx">{e.product}</p>}
                    {e.bullets.length > 0 && <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>}
                    {e.stack && <p class="stack">{e.stack}</p>}
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="skills">
      <div class="wrap">
        <p class="eyebrow">Toolkit</p>
        <h2>What I work with</h2>
        <div class="skills">
          {skills.map((g) => (
            <div>
              <h3>{g.group}</h3>
              <div class="chips">{g.items.map((s) => <span class="chip">{s}</span>)}</div>
            </div>
          ))}
        </div>
        <div class="edu">
          {education.map((e) => (
            <p><strong>{e.degree}</strong> · {e.school} · <span class="muted">{e.dates} · {e.note}</span></p>
          ))}
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="wrap contact">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>Let’s talk</h2>
          <p class="muted">Looking for AI/LLM full stack or senior engineering roles, remote or based in Coimbatore. I can start immediately.</p>
        </div>
        <ul class="contact-list">
          <li><span class="eyebrow">Email</span><a href={`mailto:${person.email}`}>{person.email}</a></li>
          <li><span class="eyebrow">Phone</span><a href={`tel:${person.phone.replace(/\s/g, '')}`}>{person.phone}</a></li>
          <li><span class="eyebrow">LinkedIn</span><a href={person.links.linkedin}>linkedin.com/in/mathi-s</a></li>
          <li><span class="eyebrow">GitHub</span><a href={person.links.github}>github.com/mathi1322</a></li>
          <li><span class="eyebrow">Learning log</span><a href={person.links.proof}>Daily build log on Proof</a></li>
        </ul>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero { padding-top: 56px; padding-bottom: 48px; }
  @media (min-width: 860px) { .hero { padding-top: 96px; padding-bottom: 64px; } }
  .hero > * { max-width: 820px; }
  .id { display: flex; align-items: center; gap: 16px; }
  .avatar { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 2px solid var(--card); box-shadow: 0 0 0 1px var(--line); }
  @media (min-width: 720px) { .avatar { width: 88px; height: 88px; } }
  .status { display: inline-flex; align-items: center; gap: 8px; margin: 0; font: 500 14px/1.3 var(--sans); color: var(--accent); }
  .loc { margin: 4px 0 0; font-size: 14px; color: var(--ink-3); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  h1 { font-size: clamp(42px, 7vw, 72px); margin: 28px 0 10px; }
  .role { font: 500 clamp(17px, 2vw, 20px)/1.4 var(--sans); color: var(--accent); margin: 0 0 16px; }
  .pitch { font: 400 clamp(18px, 2.2vw, 21px)/1.55 var(--sans); color: var(--ink-2); margin: 0 0 32px; max-width: 46ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; }

  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; margin: 0 0 72px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  @media (min-width: 720px) { .stats { grid-template-columns: repeat(4, 1fr); } }
  .stats div { background: var(--card); padding: 20px; }
  .stats dt { font: 650 34px/1 var(--serif); letter-spacing: -0.03em; }
  .stats dd { margin: 6px 0 0; font-size: 14px; color: var(--ink-2); }

  h2 em { font-style: normal; color: var(--accent); }
  .eyebrow + h2 { margin-top: 12px; }
  .lede { max-width: 60ch; margin: -12px 0 20px; }
  .legend { display: flex; flex-wrap: wrap; gap: 16px; font-size: 13px; color: var(--ink-2); margin-bottom: 24px; }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .legend i { width: 10px; height: 10px; border-radius: 3px; }
  .legend .ai { background: var(--ai); } .legend .guard { background: var(--guard); } .legend .human { background: var(--human); }

  .cards { display: grid; gap: 16px; }
  @media (min-width: 760px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  .card {
    display: flex; flex-direction: column; gap: 12px; padding: 24px; text-decoration: none;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    transition: border-color .15s ease, transform .15s ease;
  }
  .card:hover { border-color: var(--ink-3); transform: translateY(-2px); }
  .card:first-child { border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); }
  @media (min-width: 760px) { .card:first-child { grid-column: 1 / -1; } .card:first-child h3 { font-size: 28px; } .card:first-child p { max-width: 70ch; } }
  .card-top { display: flex; justify-content: space-between; align-items: center; }
  .arrow { color: var(--ink-3); transition: transform .15s ease; }
  .card:hover .arrow { transform: translateX(3px); color: var(--accent); }
  .card h3 { font-size: 23px; }
  .card p { margin: 0; font-size: 15px; }

  .ladder { list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-wrap: wrap; gap: 6px; align-items: flex-end; }
  .ladder li {
    font: 500 13px/1 var(--sans); padding: 10px 14px; border-radius: 10px;
    background: color-mix(in srgb, var(--accent) calc(10% + var(--i) * 18%), var(--card));
    color: var(--ink); border: 1px solid var(--line);
    margin-bottom: calc(var(--i) * 4px);
  }
  .ladder li:last-child { color: var(--accent-ink); }
  .co { margin: 0 0 20px; }
  .timeline article { display: grid; gap: 4px 28px; padding: 22px 0; border-top: 1px dashed var(--line); }
  @media (min-width: 760px) { .timeline article { grid-template-columns: 170px 1fr; } }
  .when { font: 500 13px/1.6 var(--mono); color: var(--ink-3); }
  .timeline h3 { font: 600 18px/1.35 var(--sans); }
  .eng + .eng { margin-top: 16px; }
  .ctx { margin: 6px 0 4px; font-size: 15px; font-weight: 500; color: var(--accent); }
  .timeline ul { margin: 6px 0 0; padding-left: 18px; color: var(--ink-2); font-size: 16px; }
  .timeline li { margin: 4px 0; }
  .stack { margin: 8px 0 0; font: 400 13px/1.5 var(--mono); color: var(--ink-3); }

  .skills { display: grid; gap: 28px; }
  @media (min-width: 760px) { .skills { grid-template-columns: repeat(2, 1fr); } .skills > div:first-child { grid-column: 1 / -1; } }
  .skills h3 { font: 600 15px/1 var(--sans); margin-bottom: 12px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .skills > div:first-child .chip { background: var(--accent-soft); color: var(--ink); border-color: color-mix(in srgb, var(--accent) 30%, transparent); }
  .edu { margin-top: 40px; padding-top: 20px; border-top: 1px dashed var(--line); }
  .edu p { margin: 6px 0; }

  .contact { display: grid; gap: 32px; }
  @media (min-width: 860px) { .contact { grid-template-columns: 1fr 1fr; align-items: start; } }
  .contact-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); }
  .contact-list li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; padding: 16px 20px; border-top: 1px solid var(--line); }
  .contact-list li:first-child { border-top: 0; }
  .contact-list a { font-weight: 500; word-break: break-word; }
</style>
