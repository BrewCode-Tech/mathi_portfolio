---
import Base from '../../layouts/Base.astro';
import Flow from '../../components/Flow.astro';
import { projects, person } from '../../content/profile';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const base = import.meta.env.BASE_URL;
const i = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(i + 1) % projects.length];
---
<Base title={`${p.name} — ${person.name}`} description={p.tagline}>
  <main class="wrap">
    <a class="back" href={`${base}#work`}>← All work</a>
    <header>
      <p class="eyebrow">{p.kind}</p>
      <h1>{p.name}</h1>
      <p class="tagline">{p.tagline}</p>
      <div class="meta">
        {p.stack && <div class="chips">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>}
        <div class="links">
          {p.live && <a class="btn primary" href={p.live}>Try it live ↗</a>}
          {p.repo ? <a class="btn" href={p.repo}>View code on GitHub ↗</a> : p.repoNote && <span class="note">{p.repoNote}</span>}
        </div>
      </div>
    </header>

    <div class="grid2">
      <div><h2>The problem</h2><p>{p.problem}</p></div>
      <div><h2>My role</h2><p>{p.role}</p></div>
    </div>

    <h2 class="sec">How it works</h2>
    <Flow steps={p.flow} />

    {p.shots && (
      <>
        <h2 class="sec">Screens</h2>
        <div class="shots">
          {p.shots.map((s) => (
            <figure>
              <img src={`${base}${s.src}`} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" />
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))}
        </div>
      </>
    )}

    {p.decisions && (
      <>
        <h2 class="sec">Key decisions</h2>
        <div class="decisions">
          {p.decisions.map((d) => (
            <article><h3>{d.title}</h3><p>{d.body}</p></article>
          ))}
        </div>
      </>
    )}

    {p.results && (
      <>
        <h2 class="sec">Outcome</h2>
        <ul class="results">{p.results.map((r) => <li>{r}</li>)}</ul>
      </>
    )}

    <a class="next" href={`${base}projects/${next.slug}/`}>
      <span class="eyebrow">Next</span>
      <span class="next-name">{next.name} →</span>
    </a>
  </main>
</Base>

<style>
  main { padding-top: 32px; padding-bottom: 72px; max-width: 920px; }
  .back { font-size: 14px; color: var(--ink-2); text-decoration: none; }
  header { padding: 28px 0 40px; border-bottom: 1px solid var(--line); margin-bottom: 40px; }
  h1 { font-size: clamp(36px, 6vw, 60px); margin: 12px 0 16px; }
  .tagline { font: 400 clamp(18px, 2.2vw, 21px)/1.55 var(--sans); color: var(--ink-2); margin: 0 0 24px; max-width: 52ch; }
  .meta { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .note { font: 500 13px/1.4 var(--mono); color: var(--ink-3); }
  h2 { font-size: 26px; margin-bottom: 10px; }
  .sec { margin: 52px 0 18px; }
  .grid2 { display: grid; gap: 28px; }
  @media (min-width: 760px) { .grid2 { grid-template-columns: 1fr 1fr; gap: 40px; } }
  .grid2 p { margin: 0; color: var(--ink-2); }
  .shots { display: grid; gap: 28px; }
  .shots figure { margin: 0; }
  .shots img { width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); box-shadow: 0 12px 32px -18px rgb(0 0 0 / .35); }
  .shots figcaption { margin-top: 10px; font-size: 14px; color: var(--ink-3); }
  .decisions { display: grid; gap: 14px; }
  .decisions article { padding: 20px 22px; border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 10px; background: var(--card); }
  .decisions h3 { font: 600 17px/1.3 var(--sans); margin-bottom: 6px; }
  .decisions p { margin: 0; color: var(--ink-2); font-size: 16px; }
  .results { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .results li { padding-left: 26px; position: relative; }
  .results li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-weight: 600; }
  .next { display: flex; flex-direction: column; gap: 8px; margin-top: 64px; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); text-decoration: none; }
  .next:hover { border-color: var(--ink-3); }
  .next-name { font: 650 24px/1.2 var(--serif); letter-spacing: -0.02em; }
</style>
