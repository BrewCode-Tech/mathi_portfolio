---
import Base from '../../layouts/Base.astro';
import { person, roles, company, projects, skills, education, site } from '../../content/profile';

const base = import.meta.env.BASE_URL;
const sideProjects = projects.filter((p) => p.kind === 'Own project' && p.onResume !== false);
const host = site.url.replace('https://', '');
---
<Base title={`Resume — ${person.name}`} description={person.summary[0]}>
  <div class="tools wrap">
    <a href={base}>← Portfolio</a>
    <a class="btn primary" href={`${base}Mathivanan-S-Resume.pdf`} download>Download PDF</a>
  </div>
  <main class="sheet">
    <header>
      <h1>{person.name}</h1>
      <p class="hl">{person.headline}</p>
      <p class="contact">
        {person.location} · {person.availability}<br />
        {person.phone} · <a href={`mailto:${person.email}`}>{person.email}</a><br />
        <a href={site.url}>{host}</a>{' · '}
        <a href={person.links.linkedin}>linkedin.com/in/mathi-s</a>{' · '}
        <a href={person.links.github}>github.com/mathi1322</a>
      </p>
    </header>

    <h2>Summary</h2>
    <p class="summary">{person.summary.join(' ')}</p>

    <h2>Skills</h2>
    <ul class="skills">
      {skills.map((g) => <li><strong>{g.group}:</strong> {g.items.join(', ')}</li>)}
    </ul>

    <h2>Experience</h2>
    <p class="co"><span><strong>{company.name}</strong>, {company.place}</span><span class="r">{company.dates}</span></p>
    {roles.map((r) => (
      <div class="role">
        <p class="rt"><strong>{r.title}</strong><span class="r">{r.dates}</span></p>
        {r.engagements.map((e) => (
          <>
            {e.product && <p class="ctx">{[e.product, e.stack].filter(Boolean).join(' · ')}</p>}
            {e.bullets.length > 0 && <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>}
          </>
        ))}
      </div>
    ))}

    <h2>Projects</h2>
    {sideProjects.map((p) => (
      <div class="role">
        <p class="rt"><span><strong>{p.name}</strong>{p.stack && <> · {p.stack.join(', ')}</>}</span><span class="r">{p.live ? <a href={p.live}>live demo</a> : p.repo ? <a href={p.repo}>GitHub</a> : p.repoNote && 'private · demo on portfolio'}</span></p>
        <ul><li>{p.summary ?? p.tagline}</li>{p.how && <li>{p.how}</li>}</ul>
      </div>
    ))}

    <h2>Education</h2>
    {education.map((e) => <p class="rt"><span><strong>{e.degree}</strong>, {e.school} · {e.note}</span><span class="r">{e.dates}</span></p>)}

  </main>
</Base>

<style>
  .tools { display: flex; justify-content: space-between; align-items: center; padding-top: 20px; padding-bottom: 20px; }
  .tools a { font-size: 14px; color: var(--ink-2); text-decoration: none; }
  .sheet {
    max-width: 820px; margin: 0 auto 64px; padding: 40px 44px;
    background: var(--card); border: 1px solid var(--line); border-radius: 6px;
    font-size: 14px; line-height: 1.5;
  }
  @media (max-width: 640px) { .sheet { margin: 0 16px 48px; padding: 24px 18px; } }
  h1 { font-size: 32px; }
  .hl { font-weight: 600; margin: 4px 0 6px; }
  .contact { margin: 0; color: var(--ink-2); font-size: 13px; }
  h2 { font: 600 12px/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--accent); margin: 22px 0 8px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  p { margin: 0 0 4px; }
  ul { margin: 2px 0 8px; padding-left: 18px; }
  li { margin: 1px 0; }
  .skills { list-style: none; padding: 0; }
  .summary { line-height: 1.5; }
  .co, .rt { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .co > :first-child, .rt > :first-child { flex: 1; min-width: 0; }
  .r { color: var(--ink-3); font-size: 13px; white-space: nowrap; }
  .ctx { color: var(--ink-2); font-style: italic; font-size: 13px; }
  .role { margin-top: 8px; }
  li { break-inside: avoid; }
  .rt, .ctx, h2 { break-after: avoid; }

  @media print {
    @page { size: A4; margin: 10mm 13mm; }
    :global(.top), :global(.foot), .tools { display: none !important; }
    :global(html), :global(body) { background: #fff !important; color: #000 !important; }
    .sheet { border: 0; margin: 0; padding: 0; max-width: none; background: #fff; font-size: 9.8pt; line-height: 1.38; color: #000; }
    h2 { margin: 12px 0 5px; }
    ul { margin: 1px 0 4px; }
    .role { margin-top: 5px; }
    .sheet * { color: #000 !important; }
    h2 { color: #0f6b55 !important; border-color: #bbb; }
    a { text-decoration: none; }
  }
</style>
