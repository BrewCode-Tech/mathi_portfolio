---
import Base from '../../layouts/Base.astro';
import { person, roles, company, currentFocus, projects, skills, education, site } from '../../content/profile';

const base = import.meta.env.BASE_URL;
const sideProjects = projects.filter((p) => p.kind === 'Own project' && p.onResume !== false);
const host = site.url.replace('https://', '');
---
<Base title={`Resume — ${person.name}`} description={person.summary[0]}>
  <div class="tools wrap">
    <a href={base}>← Portfolio</a>
    <a class="btn primary" href={`${base}Mathivanan-S-Resume.pdf`} download>Download PDF</a>
  </div>
  <main class="sheet">
    <header>
      <h1>{person.name}</h1>
      <p class="hl">{person.headline}</p>
      <div class="contact">
        <p>{[person.location, ...person.availability.split(' · ')].map((x, i) => <>{i > 0 && <i>|</i>}<span>{x}</span></>)}<i>|</i><a href={`tel:${person.phone.replace(/\s/g, '')}`}>{person.phone}</a></p>
        <p>
          <a href={`mailto:${person.email}`}>{person.email}</a><i>|</i><a href={site.url}>{host}</a><i>|</i><a href={person.links.linkedin}>linkedin.com/in/mathi-s</a><i>|</i><a href={person.links.github}>github.com/mathi1322</a>
        </p>
      </div>
    </header>

    <h2>Summary</h2>
    <p class="summary">{person.summary.join(' ')}</p>

    <h2>Skills</h2>
    <ul class="skills">
      {skills.map((g) => <li><strong>{g.group}:</strong> {g.items.join(', ')}</li>)}
    </ul>

    <h2>Experience</h2>
    <div class="role now">
      <p class="rt"><strong>{currentFocus.title}</strong><span class="r">{currentFocus.dates}</span></p>
      <ul>{currentFocus.bullets.map((b) => <li>{b}</li>)}</ul>
    </div>
    <p class="co"><span><strong>{company.name}</strong>, {company.place}</span><span class="r">{company.dates}</span></p>
    {roles.map((r) => (
      <div class="role">
        <p class="rt"><strong>{r.title}</strong><span class="r">{r.dates}</span></p>
        {r.engagements.map((e) => (
          <>
            {e.product && <p class="ctx"><span class="prod">{e.product}</span>{e.stack && <>{' · '}<span class="stk">{e.stack}</span></>}</p>}
            {e.bullets.length > 0 && <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>}
          </>
        ))}
      </div>
    ))}

    <h2>Projects</h2>
    {sideProjects.map((p) => (
      <div class="role">
        <p class="rt"><span><strong>{p.name}</strong>{p.stack && <>{' · '}<span class="stk">{p.stack.join(', ')}</span></>}</span><span class="r">{p.live ? <a href={p.live}>live demo</a> : p.repo && <a href={p.repo}>GitHub</a>}</span></p>
        <ul><li>{p.summary ?? p.tagline}</li>{p.how && <li>{p.how}</li>}</ul>
      </div>
    ))}

    <h2>Education</h2>
    {education.map((e) => <p class="rt"><span><strong>{e.degree}</strong>, {e.school} · {e.note}</span><span class="r">{e.dates}</span></p>)}

  </main>
</Base>

<style>
  .tools { display: flex; justify-content: space-between; align-items: center; padding-top: 20px; padding-bottom: 20px; }
  .tools a:not(.btn) { font-size: 14px; color: var(--ink-2); text-decoration: none; }
  .sheet {
    max-width: 820px; margin: 0 auto 64px; padding: 44px 48px;
    background: var(--card); border: 1px solid var(--line); border-radius: 6px;
    font-size: 15px; line-height: 1.5;
  }
  @media (max-width: 640px) { .sheet { margin: 0 16px 48px; padding: 24px 18px; font-size: 14px; } }
  header { text-align: center; }
  h1 { font-size: 34px; font-weight: 700; letter-spacing: .01em; text-transform: uppercase; }
  .hl { font-size: 17px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin: 6px 0 12px; }
  .contact { border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); padding: 7px 0; font-size: 14px; }
  .contact p { margin: 1px 0; }
  .contact i { font-style: normal; margin: 0 8px; color: var(--ink-3); }
  .contact a, .contact span { white-space: nowrap; }
  .contact a, .r a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 2px; text-decoration-color: color-mix(in srgb, currentColor 45%, transparent); }
  .contact a:hover, .r a:hover { text-decoration-color: currentColor; }
  h2 { font: 700 16px/1.2 var(--sans); letter-spacing: .03em; text-transform: uppercase; color: var(--ink); margin: 22px 0 8px; padding-bottom: 5px; border-bottom: 1px solid var(--ink); }
  p { margin: 0 0 4px; }
  ul { margin: 3px 0 8px; padding-left: 20px; }
  li { margin: 2px 0; }
  .skills { list-style: none; padding: 0; }
  .co, .rt { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .co > :first-child, .rt > :first-child { flex: 1; min-width: 0; }
  .rt strong, .co strong { font-weight: 700; }
  .r { font-weight: 700; white-space: nowrap; }
  .ctx { margin-top: 2px; }
  .prod { font-weight: 600; }
  .stk { color: var(--ink-2); display: inline-block; } /* wraps as a unit, never one orphan word */
  .rt .stk { color: inherit; }
  .role { margin-top: 10px; }
  .now { margin: 0 0 10px; }
  li { break-inside: avoid; }
  .rt, .ctx, h2 { break-after: avoid; }

  @media print {
    @page { size: A4; margin: 11mm 13mm; }
    :global(.top), :global(.foot), .tools { display: none !important; }
    :global(html), :global(body) { background: #fff !important; color: #000 !important; }
    .sheet { border: 0; margin: 0; padding: 0; max-width: none; background: #fff; font-size: 10.5pt; line-height: 1.38; color: #000; }
    .sheet * { color: #000 !important; }
    h1 { font-size: 22pt; }
    .hl { font-size: 12pt; margin: 3px 0 8px; }
    .contact { font-size: 9.8pt; padding: 5px 0; border-color: #000; }
    .contact i { color: #000 !important; }
    h2 { font-size: 11.5pt; margin: 12px 0 5px; padding-bottom: 3px; border-color: #000; }
    ul { margin: 1px 0 4px; }
    li { margin: 1px 0; }
    .role { margin-top: 6px; }
    .stk { color: #333 !important; }
    .contact a, .r a { text-decoration-color: #888; }
  }
</style>
