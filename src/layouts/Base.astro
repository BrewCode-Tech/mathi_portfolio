---
import '../styles/global.css';
import { site, person } from '../content/profile';

interface Props {
  title?: string;
  description?: string;
  nav?: boolean;
}
const { title = site.title, description = site.description, nav = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('me.jpg', site.url + '/').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    {nav && (
      <header class="top">
        <div class="wrap bar">
          <a href={base} class="mark">{person.shortName}<span>.</span></a>
          <nav>
            <a href={`${base}#work`}>Work</a>
            <a href={`${base}#experience`}>Experience</a>
            <a href={`${base}resume/`}>Resume</a>
            <button id="theme" type="button" aria-label="Toggle dark mode">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>
          </nav>
        </div>
      </header>
    )}
    <slot />
    {nav && (
      <footer class="wrap foot">
        <span>© {new Date().getFullYear()} {person.name}</span>
        <span class="muted">Built with Astro · hosted on GitHub Pages</span>
      </footer>
    )}
    <script is:inline>
      document.getElementById('theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .top {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .mark { font: 700 21px/1 var(--serif); letter-spacing: -0.03em; text-decoration: none; }
  .mark span { color: var(--accent); }
  nav { display: flex; align-items: center; gap: 4px; }
  nav a { padding: 8px 10px; font-size: 15px; text-decoration: none; color: var(--ink-2); border-radius: 8px; }
  nav a:hover { color: var(--ink); background: var(--paper-2); }
  #theme {
    margin-left: 4px; width: 36px; height: 36px; display: grid; place-items: center;
    border: 1px solid var(--line); border-radius: 999px; background: var(--card); color: var(--ink-2); cursor: pointer;
  }
  @media (max-width: 420px) { nav a:nth-child(2) { display: none; } }
  .foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px;
    padding-top: 28px; padding-bottom: 40px; font-size: 14px; color: var(--ink-2);
    border-top: 1px solid var(--line);
  }
</style>
